            Someone has prepared a tiny surprise for you...
        </p>

        <h2>Are you ready? 😏</h2>

        <div class="buttons">
            <button id="yes" onclick="startGame()">YES 💗</button>
            <button id="no" onmouseover="runAway(this)" onclick="runAway(this)">
                NO 😐
            </button>
        </div>
    </div>


    <!-- GAME SCREEN -->
    <div id="game" class="hidden">

        <div class="emoji">😏</div>

        <h1 id="question"></h1>

        <p id="subtext"></p>

        <div class="buttons">
            <button id="yes" onclick="nextQuestion()">YES ❤️</button>

            <button id="no" onclick="runAway(this)" onmouseover="runAway(this)">
                NO 😭
            </button>
        </div>

    </div>


    <!-- FINAL SCREEN -->
    <div id="final" class="hidden final">

        <div class="big">🎉🎂🎈</div>

        <div class="birthday">
            HAPPY BIRTHDAY<br>
            ANISH! 🥳
        </div>

        <p>
            You finally made it! 😂❤️
        </p>

        <p>
            Wishing you lots of happiness, success,
            amazing memories and an absolutely
            awesome year ahead! ✨
        </p>

        <p>
            Stay happy, stay crazy and keep smiling! 😎
        </p>

        <div style="font-size:45px;">
            🎁 ❤️ 🥳 🎂
        </div>

        <p class="small">
            Made specially for Anish 💫
        </p>

    </div>

</div>


